# Written by setup/setup.sh or setup/setup.ps1. Never commit .env — it holds your Tailscale auth key.
TS_AUTHKEY=
TS_HOSTNAME=muse-gateway
# The ONE folder Muse may use (uploads land here; the bench works here).
MUSE_SHARE=./shared
# lan-allow mode: space-separated LAN device IPs the bench may reach over HTTP(S).
LAN_ALLOW=
MAX_UPLOAD_MB=200
# Network mode = which overrides load. isolated: compose.yaml  open: add ;compose.open.yaml
# USB serial: add ;compose.usb.yaml
COMPOSE_FILE=compose.yaml
COMPOSE_PATH_SEPARATOR=;
